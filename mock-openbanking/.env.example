# 복사해서 mock-openbanking/.env 로 사용 (.env 는 gitignore 대상)
# 값은 mockbank-mysql/.env 에서 정한 앱·마이그레이션 계정 비밀번호와 같아야 한다 (root 비밀번호는 넣지 않는다)
MOCKBANK_DB_PASSWORD=change-me
MOCKBANK_DB_MIGRATION_PASSWORD=change-me


# 문자(SMS) 인증. 기본은 실제로 보내지 않고 인증번호를 화면과 서버 로그에 보여 준다.
# 실제로 보내려면 아래를 채운다(솔라피 키, 솔라피에 등록한 발신번호). 더미 번호(010-0000-xxxx)에는 보내지 않는다
# SOLAPI_ENABLED=true
# SOLAPI_API_KEY=
# SOLAPI_API_SECRET=
# SOLAPI_SENDER_NUMBER=
