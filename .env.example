# 복사해서 .env 로 사용 (.env 는 gitignore 대상). Spring은 .env를 자동으로 읽지 않으므로
# IntelliJ Run Configuration의 Environment variables 또는 EnvFile 플러그인으로 주입
DB_USERNAME=bastionpay_app
DB_PASSWORD=change-me
DB_MIGRATION_USERNAME=bastionpay_migrator
DB_MIGRATION_PASSWORD=change-me
JWT_SECRET=change-me-min-32-bytes-random
OPENBANKING_CLIENT_ID=
OPENBANKING_CLIENT_SECRET=
# 이용기관코드(10자리, 잔액조회 거래고유번호용). 토큰 암호화 키는 기본으로 JWT_SECRET 에서 만들며 따로 두려면 OPENBANKING_TOKEN_SECRET
OPENBANKING_ORG_CODE=
# 입금이체 암호문구: 이체(출금 후 수취 계좌로 입금)에 필요하다. 가짜 서버는 db/seed/README.md 참고
OPENBANKING_PASS_PHRASE=
# 개발 HTTPS 인증서(config/local-dev.p12) 없이 http로 띄우려면 false
# DEV_HTTPS=true

# 인증 메일 (Gmail SMTP). Google 계정의 2단계 인증을 켠 뒤 '앱 비밀번호'를 발급해 사용
# 비워 두면 dev 프로파일에서는 인증 코드가 콘솔 로그로 출력됨
MAIL_USERNAME=
MAIL_PASSWORD=

# 보안 이벤트 (선택). 값을 비우면 아래 기본값을 쓴다
# 로그인 계정 식별값(HMAC) 키. 기본은 JWT_SECRET 에서 파생. 따로 두려면 설정
# SECURITY_LOG_HMAC_KEY=
# X-Forwarded-For 를 믿을 프록시 IP(쉼표 구분). 비우면 실제 접속 주소만 쓴다
# TRUSTED_PROXIES=
# 로그인 실패 자동 잠금 대상(합성 테스트 계정). 실제 가입 계정은 넣지 않는다
# LOCKOUT_ALLOWLIST=test@test.com,vip@test.com,vvip@test.com
# 보안 이벤트 JSONL 경로 (Graylog·Wazuh 수집 대상)
# SECURITY_EVENT_LOG_FILE=logs/security-events.jsonl

# 서버 간 호출 API(n8n 등)용 키. 비워 두면 /api/admin/** 는 항상 401(닫힘). 긴 무작위 문자열을 쓴다
# SECURITY_API_KEY=
# 관리자 권한을 가져도 되는 이메일(쉼표 구분). 이 밖의 관리자는 보안 대시보드에 과잉권한으로 표시
# ADMIN_ALLOWLIST=admin@test.com
