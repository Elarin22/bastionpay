<!-- 5. Snort 탐지 -->
<!-- ================================================== -->
<group name="snort,ids,local,">
  <rule id="100264" level="3">
    <decoded_as>snort-alert</decoded_as>
    <description>Snort NIDS Alert 발생</description>
    <group>ids_alert,</group>
  </rule>
  <rule id="100265" level="10">
    <if_sid>100264</if_sid>
    <field name="signature" type="pcre2">(?i)(portscan|port scan|snort-portscan)</field>
    <description>Snort 네트워크 포트스캔 탐지 (S11)</description>
    <mitre><id>T1046</id></mitre>
    <group>ids_alert,port_scan,</group>
  </rule>
</group>
<!-- BastionPay rules mapped from enabled Graylog Event Definitions -->
<group name="bastionpay,application,local,">
  <!-- Base match: one bad-password login failure with an account hash; no standalone alert -->
  <rule id="100266" level="1">
    <decoded_as>json</decoded_as>
    <if_sid>1002</if_sid>
    <field name="app_name">^bastionpay$</field>
    <field name="event_type">^LOGIN_FAILURE$</field>
    <field name="outcome">^FAILURE$</field>
    <field name="reason_code">^BAD_CREDENTIALS$</field>
    <field name="source_ip">.+</field>
    <field name="login_subject_hash">.+</field>
    <description>BastionPay bad-password login failure base event</description>
    <options>no_log</options>
  </rule>

  <!-- L2: same source IP, five distinct synthetic accounts, five minutes -->
  <rule id="100267" level="10" frequency="5" timeframe="300">
    <if_matched_sid>100266</if_matched_sid>
    <same_field>source_ip</same_field>
    <different_field>login_subject_hash</different_field>
    <description>BastionPay password spraying suspected: five distinct accounts from one IP in five minutes (src_ip=$(source_ip))</description>
    <mitre><id>T1110.003</id></mitre>
    <group>authentication_failures,password_spraying,</group>
  </rule>

  <!-- S1: same source IP and same synthetic account, five failures in ten minutes -->
  <rule id="100268" level="10" frequency="5" timeframe="600">
    <if_matched_sid>100266</if_matched_sid>
    <same_field>source_ip</same_field>
    <same_field>login_subject_hash</same_field>
    <description>BastionPay repeated login failures for the same account and source IP (src_ip=$(source_ip))</description>
    <mitre><id>T1110.001</id></mitre>
    <group>authentication_failures,brute_force,</group>
  </rule>

  <!-- S2: a completed refund after mock-bank transfer failure -->
  <rule id="100269" level="8">
    <decoded_as>json</decoded_as>
    <field name="app_name">^bastionpay$</field>
    <field name="event_type">^TRANSFER_REFUNDED$</field>
    <description>BastionPay transfer failed and refund completed (src_ip=$(source_ip), transfer_id=$(transfer_id))</description>
    <group>banking,transfer_refund,</group>
  </rule>

  <!-- S3: two or more refunds with same IP, severity and reason in ten minutes -->
  <rule id="100270" level="10" frequency="2" timeframe="600">
    <if_matched_sid>100269</if_matched_sid>
    <same_field>source_ip</same_field>
    <same_field>severity</same_field>
    <same_field>reason_code</same_field>
    <description>BastionPay repeated transfer refunds from same source IP (src_ip=$(source_ip), reason=$(reason_code))</description>
    <group>banking,transfer_refund,correlation,</group>
  </rule>

  <!-- F: three server API authentication failures from one source IP in five minutes -->
  <rule id="100271" level="0">
    <decoded_as>json</decoded_as>
    <field name="app_name">^bastionpay$</field>
    <field name="event_type">^API_AUTH_FAILED$</field>
    <field name="source_ip">.+</field>
    <description>BastionPay API authentication failure base event</description>
    <options>no_log</options>
  </rule>
  <rule id="100272" level="10" frequency="3" timeframe="300">
    <if_matched_sid>100271</if_matched_sid>
    <same_field>source_ip</same_field>
    <description>BastionPay repeated server API authentication failures (src_ip=$(source_ip))</description>
    <group>authentication_failures,api_auth,</group>
  </rule>

  <!-- E: two blocked-IP requests from one source IP in five minutes -->
  <rule id="100273" level="0">
    <decoded_as>json</decoded_as>
    <field name="app_name">^bastionpay$</field>
    <field name="event_type">^IP_BLOCKED_REQUEST$</field>
    <field name="source_ip">.+</field>
    <description>BastionPay blocked-IP request base event</description>
    <options>no_log</options>
  </rule>
  <rule id="100274" level="10" frequency="2" timeframe="300">
    <if_matched_sid>100273</if_matched_sid>
    <same_field>source_ip</same_field>
    <description>BastionPay repeated requests from an application-blocked IP (src_ip=$(source_ip))</description>
    <group>access_control,blocked_ip,</group>
  </rule>
</group>
<!-- BastionPay additional scenarios and source-tree FIM -->
<group name="bastionpay,application,local,">
  <!-- Base: repeated unauthorized feature access from one IP -->
  <rule id="100275" level="1">
    <decoded_as>json</decoded_as>
    <field name="app_name">^bastionpay$</field>
    <field name="event_type">^ACCESS_DENIED$</field>
    <field name="outcome">^DENIED$</field>
    <field name="source_ip">.+</field>
    <description>BastionPay unauthorized access base event</description>
    <options>no_log</options>
  </rule>
  <rule id="100276" level="10" frequency="5" timeframe="300">
    <if_matched_sid>100275</if_matched_sid>
    <same_field>source_ip</same_field>
    <description>BastionPay repeated unauthorized access from one source IP (src_ip=$(source_ip))</description>
    <mitre><id>T1078</id></mitre>
    <group>access_control,authorization_failure,</group>
  </rule>

  <!-- Base: transfer requests, correlated by member_id -->
  <rule id="100277" level="1">
    <decoded_as>json</decoded_as>
    <field name="app_name">^bastionpay$</field>
    <field name="event_type">^TRANSFER_REQUESTED$</field>
    <field name="member_id">.+</field>
    <description>BastionPay transfer request base event</description>
    <options>no_log</options>
  </rule>
  <rule id="100278" level="8" frequency="5" timeframe="300">
    <if_matched_sid>100277</if_matched_sid>
    <same_field>member_id</same_field>
    <description>BastionPay transfer request spike for one member in five minutes (member_id=$(member_id))</description>
    <group>banking,transfer_frequency,</group>
  </rule>

  <!-- Base: a request observed while the source IP is blocked -->
  <rule id="100279" level="1">
    <decoded_as>json</decoded_as>
    <field name="app_name">^bastionpay$</field>
    <field name="event_type">^IP_BLOCKED_REQUEST$</field>
    <field name="source_ip">.+</field>
    <description>BastionPay blocked-IP request correlation base event</description>
    <options>no_log</options>
  </rule>
  <rule id="100280" level="12" frequency="2" timeframe="600">
    <if_matched_sid>100279</if_matched_sid>
    <field name="app_name">^bastionpay$</field>
    <field name="event_type">^LOGIN_SUCCESS$</field>
    <field name="outcome">^SUCCESS$</field>
    <field name="source_ip">.+</field>
    <same_field>source_ip</same_field>
    <description>BastionPay login succeeded from an IP with a blocked request in the previous ten minutes (src_ip=$(source_ip))</description>
    <mitre><id>T1078</id></mitre>
    <group>access_control,blocked_ip,correlation,</group>
  </rule>
  <rule id="100281" level="12" frequency="2" timeframe="600">
    <if_matched_sid>100279</if_matched_sid>
    <field name="app_name">^bastionpay$</field>
    <field name="event_type">^TRANSFER_REQUESTED$</field>
    <field name="source_ip">.+</field>
    <same_field>source_ip</same_field>
    <description>BastionPay transfer requested from an IP with a blocked request in the previous ten minutes (src_ip=$(source_ip))</description>
    <group>access_control,blocked_ip,correlation,banking,</group>
  </rule>
</group>

<group name="bastionpay,syscheck,local,">
  <rule id="100282" level="8">
    <if_sid>550,553,554</if_sid>
    <field name="file" type="pcre2">(?i)^C:\\Users\\user\\Desktop\\bastionpay\\src\\</field>
    <description>BastionPay source tree file changed (path=$(file))</description>
    <mitre><id>T1565.001</id></mitre>
    <group>syscheck,file_integrity,bastionpay,</group>
  </rule>
</group>



